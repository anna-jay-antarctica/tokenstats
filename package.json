{
    "name":  "opencode-tokenstat",
    "version":  "0.2.1",
    "description":  "Token usage, cache hit rate, and per-model usage breakdowns in the OpenCode TUI.",
    "type":  "module",
    "scripts":  {
                    "dev:copy":  "node scripts/copy-local.mjs",
                    "test":  "node --experimental-strip-types --test tests/usage.test.ts"
                },
    "exports":  {
                    ".":  "./index.ts",
                    "./tui":  "./tui.tsx"
                },
    "files":  [
                  "index.ts",
                   "tui.tsx",
                   "usage.ts",
                   "README.md",
                   "CHANGELOG.md",
                  "LICENSE"
              ],
    "dependencies":  {
                         "@opencode/plugin":  "latest"
                     },
    "peerDependencies":  {
                             "@opentui/core":  "\u003e=0.5.8",
                             "@opentui/solid":  "\u003e=0.5.8",
                             "solid-js":  "\u003e=1.9.0"
                         },
    "keywords":  [
                     "opencode",
                     "opencode-plugin",
                     "tui",
                     "tokens",
                     "usage"
                 ],
    "engines":  {
                    "node":  "\u003e=20"
                },
    "license":  "Apache-2.0"
}
